# Public hosted relay, or localhost when using the included temporary demo tunnel.
REAPER_RELAY_URL=ws://127.0.0.1:8787

# Must match the website. Generate a private token with at least 16 characters.
REAPER_MACHINE_ID=sruthin-studio
REAPER_PAIRING_TOKEN=

# The companion intentionally accepts only a loopback REAPER Web Control URL.
REAPER_BASE_URL=http://127.0.0.1:8089

# Cue Recall's approved master asset project. This file is read as an asset only.
CUE_ASSET_PATH=/Volumes/Extreme SSD/pocket fm/france/tool test/ai mastering training/ai mastering training.RPP

# Keep false for Import, Recall, and opening the ElevenLabs UI.
# Set true only for an explicitly approved paid Build Immersive & Play demo.
ALLOW_PAID_VOICE_GENERATION=false

# Optional. By default the atomic safety journal is kept in:
# ~/Library/Application Support/Story Cue Studio/remote-companion-journal.json
# REAPER_JOB_JOURNAL_PATH=/absolute/private/path/remote-companion-journal.json

# Relay process settings. A cloud host usually supplies PORT automatically.
PORT=8787
HOST=127.0.0.1
